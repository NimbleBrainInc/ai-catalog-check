{
  "name": "ai-catalog-check",
  "version": "0.1.2",
  "description": "Conformance suite for the AI Catalog specification: every normative statement numbered and traced, checked from a CLI or a GitHub Action.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NimbleBrainInc/ai-catalog-check.git"
  },
  "type": "module",
  "bin": {
    "ai-catalog-check": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "requirements",
    "spec",
    "skills",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test 'test/**/*.test.ts'",
    "coverage": "node src/coverage.ts > COVERAGE.md",
    "sync": "node src/sync.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "parse5": "^8.1.1",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  }
}
